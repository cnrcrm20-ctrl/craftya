# Craftya Minecraft Sunucusu — ortam ayarları
# Bu dosyayı `.env` olarak kopyala:  cp .env.example .env
# .env dosyası .gitignore'da, sırlar repoya girmez.

# ---- sürüm ----
# Paper'ın desteklediği herhangi bir sürüm. "LATEST" her zaman en yenisini çeker.
# Profesyonel sunucularda sürüm sabitlenir: plugin uyumu bozulmasın diye.
# Örnek: MC_VERSION=1.21.4
MC_VERSION=LATEST

# ---- donanım ----
# VM'de toplam RAM'in ~%60'ı. 4 GB RAM'li VM için 2G, 12 GB için 6G.
MC_MEMORY=3G
MC_MAX_PLAYERS=20
MC_SEED=craftya

# ---- erişim ----
# Premium (satın alınmış) Minecraft hesapları zorunlu olsun mu?
# TRUE  = sadece orijinal hesaplar (hile/korsan zor)
# FALSE = herkes girebilir (test için)
MC_ONLINE_MODE=TRUE

# Beyaz liste: sadece listedekiler girebilir. Kapalıysa herkes girer.
MC_WHITELIST=FALSE

# Yönetici oyuncu isimleri, virgülle: Oyuncu1,Arkadas2
MC_OPS=

# Whitelist açıksa izinli oyuncular (virgülle): Oyuncu1,Arkadas2
MC_WHITELIST_NAMES=

# Sunucu listesinde görünen yazı. \u00a7 = renk kodu (a=yeşil, 7=gri)
MC_MOTD=\u00a7aCraftya\u00a77 - sunucu dunyasi

# ---- uzaktan yönetim ----
RCON_PASSWORD=degistir-beni-uzun-bir-sifre

# ---- opsiyonel eklentiler (Modrinth slug'ları, virgül veya satır ile) ----
# Boş = sadece çekirdek plugin'ler (ViaVersion, ViaBackwards, Geyser, Floodgate).
# Canlı sunucu için önerilen set:
#   luckperms,spark,coreprotect,chunky,simple-voice-chat
MC_EXTRA_PLUGINS=

# ---- tünel (playit.gg) ----
# playit.gg → Agents → New Agent → çıkan SECRET_KEY'i buraya yaz.
# Sonra playit.gg panelinde "Minecraft Java" tunnel'ı ekle, local adres: 127.0.0.1:25565
# Sana `xxxx.craft.playit.gg` gibi sabit bir adres verir.
PLAYIT_SECRET=
