# Craftya — ortam değişkenleri
# cp .env.example .env
#
# SIR KURALI: bu dosya repoya girmez (.gitignore). VELOCITY_SECRET ve
# RCON_PASSWORD boş bırakılabilir → render.py her çalıştırmada üretir.
# Kalıcı olması için buraya yaz (özellikle VELOCITY_SECRET: değişirse odalar
# proxy'ye bağlanamaz).

# ---- Minecraft ----
# Sürüm SABİT: devirde dünya yeniden açılıyor. 26.3 sonrası dünya geri alınamaz.
MC_VERSION=26.3

# Java sürümü sürümle eşleşmek ZORUNDA:
#   26.x   → java25     (26.1+ Java 25 ister)
#   1.21.x → java21     (1.21.11 son Java 21 sürümü)
# Yanlış eşleşme = sunucu hiç açılmaz. doctor.py bunu kontrol eder.
MC_IMAGE=itzg/minecraft-server:java25
PROXY_IMAGE=itzg/mc-proxy:java25

# ---- sırlar (boşsa üretilir) ----
VELOCITY_SECRET=
RCON_PASSWORD=

# ---- portlar (velero hariç hepsi 127.0.0.1'e bağlanır) ----
PORT_VELOCITY=25565
PORT_LOBBY=25566
# limbo odası: sadece proxy içinden erişilir, dışarıya kapalı
PORT_AUTH=25572
PORT_SURVIVAL=25567
PORT_SKYBLOCK=25568
PORT_BEDWARS=25569
PORT_DUELLO=25570
PORT_PARKUR=25571

# ---- tünel (dışarıdan erişim) ----
# playit.gg → Agents → New Agent → SECRET_KEY'i buraya
PLAYIT_SECRET=

# ---- Supabase (global veri: ban, rank, istatistik) ----
# anon anahtar herkese açıktır; service_role ASLA buraya yazılmaz.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- yönetici ----
# Java oyuncusu op listesi (virgülle, örn: Ahmet,Mehmet). Boş = kimse op değil.
# BEDROCK oyuncusu buraya YAZILMAZ: Floodgate farklı UUID üretir, ops.json tutmaz.
# Bedrock/Java yetkilendirme LuckPerms ile yapılır (aşağıdaki ADMIN_ oyuncuları).
MC_OPS=

# Otomatik yetki verilecek oyuncular: "oyuncu:grup" (virgülle).
# Bedrock oyuncusu için Floodgate ön ekiyle yaz: .bozturk2642:kurucu
# Java oyuncusu için düz yaz: bozturk2642:kurucu
# Boş bırakırsan hiç kimseye otomatik yetki verilmez (sonra elle verilir).
ADMIN_PLAYERS=.bozturk2642:kurucu

# ---- yedek ----
# kaç arşiv tutulsun (runtime/data + artifacts)
CRAFTYA_KEEP_ARCHIVES=3

# ---- bellek havuzu ----
GOVERNOR_LIMIT_GB=13     # container limitleri toplamı ~13.4 GB; governor bunun altında tutar
GOVERNOR_POOL_GB=5
GOVERNOR_INTERVAL=30
